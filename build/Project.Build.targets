<Project>

  <!--
    PROPERTIES
  -->

  <!--
    PROJECT BUILD (DEFAULT) PROPERTIES
  -->

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0')) AND '$(EnableRuntimeAsync)' == 'true'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableSourceLink)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>



  <!--
    TARGETS


    TARGET NAMING CONVENTION
    Format: [EventScope]_[ExecutionScope]_[TargetName]_[TriggerEvent]

    1. EventScope     : Lifecycle scope where the hook attaches (Project | Solution | Workspace).
    2. ExecutionScope : Operational blast radius of the target (Project | Solution | Workspace).
    3. TargetName     : Nominalized [Object][ActionNoun] phrase (e.g., ArtifactsCleanup, BuildPropertiesDisplay).
    4. TriggerEvent   : [Before|After][EventScope][MSBuildHook] (e.g., BeforeProjectBeforeBuild, AfterProjectClean).

  -->

  <!--
    PROJECT BUILD TARGETS
  -->

  <!--
    Project Build Properties Display
  -->
  <Target Name="Project_Project_BuildPropertiesDisplay_BeforeProjectBeforeBuild"
          BeforeTargets="BeforeBuild"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Message Text="$(MSBuildProjectName) ($(Configuration)\$(TargetFramework)):%0D%0A  WorkspaceFolderPath = '$(WorkspaceFolderPath)'%0D%0A  ArtifactsFolderPath = '$(ArtifactsFolderPath)'%0D%0A  BaseIntermediateOutputBaseFolderPath = '$(BaseIntermediateOutputBaseFolderPath)'%0D%0A  BaseIntermediateOutputPath = '$(BaseIntermediateOutputPath)'%0D%0A  MSBuildProjectExtensionsPath = '$(MSBuildProjectExtensionsPath)'%0D%0A  IntermediateOutputPath = '$(IntermediateOutputPath)'%0D%0A  BaseOutputBaseFolderPath = '$(BaseOutputBaseFolderPath)'%0D%0A  BaseOutputPath = '$(BaseOutputPath)'%0D%0A  OutputBaseFolderPath = '$(OutputBaseFolderPath)'%0D%0A  OutputPath = '$(OutputPath)'%0D%0A  OutDir = '$(OutDir)'%0D%0A  RunWorkingDirectory = '$(RunWorkingDirectory)'%0D%0A  TestResultsBaseFolderPath = '$(TestResultsBaseFolderPath)'%0D%0A  VSTestResultsDirectory = '$(VSTestResultsDirectory)'%0D%0A  PackageOutputBaseFolderPath = '$(PackageOutputBaseFolderPath)'%0D%0A  PackageOutputPath = '$(PackageOutputPath)'%0D%0A  PublishBaseFolderPath = '$(PublishBaseFolderPath)'%0D%0A  PublishDir = '$(PublishDir)'"
             Importance="high" />
  </Target>

  <!--
    Temporary WPF Project Folders Cleanup
    https://github.com/dotnet/wpf/issues/2930

    Clean temporary WPF project folders ("$(MSBuildProjectName)*_wpftmp") left after build.
  -->
  <Target Name="Project_Project_WpfTmpProjectsCleanup_AfterProjectAfterBuild"
          AfterTargets="AfterBuild"
          Condition="'$(IsCrossTargetingBuild)' != 'true' AND '$(UseWPF)' == 'true'">
    <Message Text="$(MSBuildProjectName): Starting WPF '*_wpftmp' projects cleanup..."
             Importance="high" />

    <!-- OutputPath (bin) -->
    <ItemGroup Condition="Exists('$(OutputBaseFolderPath)')">
      <_WpfTmpProjectOutputFolders Include="$([System.IO.Directory]::GetDirectories('$(OutputBaseFolderPath)', '$(MSBuildProjectName)*_wpftmp'))" />
    </ItemGroup>

    <!-- IntermediateOutputPath (obj) -->
    <ItemGroup Condition="Exists('$(BaseIntermediateOutputBaseFolderPath)')">
      <_WpfTmpProjectIntermediateOutputFolders Include="$([System.IO.Directory]::GetDirectories('$(BaseIntermediateOutputBaseFolderPath)', '$(MSBuildProjectName)*_wpftmp'))" />
    </ItemGroup>

    <!-- OutputPath (bin) -->
    <RemoveDir Directories="@(_WpfTmpProjectOutputFolders)"
               Condition="'@(_WpfTmpProjectOutputFolders)' != ''"
               ContinueOnError="true" />

    <!-- IntermediateOutputPath (obj) -->
    <RemoveDir Directories="@(_WpfTmpProjectIntermediateOutputFolders)"
               Condition="'@(_WpfTmpProjectIntermediateOutputFolders)' != ''"
               ContinueOnError="true" />

    <!-- Emit a single atomic log block per project so parallel worker nodes do not interleave lines. -->
    <PropertyGroup>
      <_CompletionMessage />
      <_CompletionMessage Condition="'@(_WpfTmpProjectOutputFolders)' != '' OR '@(_WpfTmpProjectIntermediateOutputFolders)' != ''">$(MSBuildProjectName): WPF '*_wpftmp' projects cleaned up:</_CompletionMessage>
      <_CompletionMessage Condition="'@(_WpfTmpProjectOutputFolders)' != ''">$(_CompletionMessage)%0D%0A  Output folders:%0D%0A    @(_WpfTmpProjectOutputFolders, '%0D%0A    ')</_CompletionMessage>
      <_CompletionMessage Condition="'@(_WpfTmpProjectIntermediateOutputFolders)' != ''">$(_CompletionMessage)%0D%0A  Intermediate output folders:%0D%0A    @(_WpfTmpProjectIntermediateOutputFolders, '%0D%0A    ')</_CompletionMessage>
      <_CompletionMessage Condition="'$(_CompletionMessage)' != ''">$(_CompletionMessage)%0D%0A</_CompletionMessage>
      <_CompletionMessage>$(_CompletionMessage)$(MSBuildProjectName): Completed WPF '*_wpftmp' projects cleanup.</_CompletionMessage>
    </PropertyGroup>

    <Message Text="$(_CompletionMessage)"
             Importance="high" />
  </Target>

  <!--
    Project bin and obj Folders Cleanup
    https://stackoverflow.com/questions/1088593/how-to-fully-clean-bin-and-obj-folders-within-visual-studio
    https://stackoverflow.com/questions/755382/i-want-to-delete-all-bin-and-obj-folders-to-force-all-projects-to-rebuild-everyt

    Project-level artifacts cleanup executed after project Clean completes.

    MSBuild/Visual Studio does not provide a reliable solution-level AfterClean hook,
    and outer cross-targeting builds do not fire AfterClean.
    Therefore, this target anchors to 'Clean' and executes during the outer cross-targeting pass
    ('$(IsCrossTargetingBuild)' == 'true') or single-framework builds.

    Condition guarantees execution runs exactly ONCE per project
    to avoid redundant multi-pass execution and prevent parallel file access collisions (MSB3231).

    Output folders across all TFMs are dynamically resolved
    under {ArtifactsFolderName}\$(OutputFolderName)\$(Configuration)\
    to handle outer-build evaluation where $(TargetFramework) is unpopulated.
  -->
  <Target Name="Project_Project_ArtifactsCleanup_AfterProjectClean"
          AfterTargets="Clean"
          Condition="'$(IsCrossTargetingBuild)' == 'true' OR '$(TargetFrameworks)' == ''">
    <Message Text="$(MSBuildProjectName): Starting project artifacts cleanup..."
             Importance="high" />

    <!-- OutputPath (bin) -->
    <!-- Locate all output folders for this project across all TFMs under '{ArtifactsFolderName}\{OutputFolderName}\{Configuration}\'. -->
    <ItemGroup Condition="Exists('$(BaseOutputBaseFolderPath)$(Configuration)')">
      <_ProjectOutputFolders Include="$([System.IO.Directory]::GetDirectories('$(BaseOutputBaseFolderPath)$(Configuration)', '$(MSBuildProjectName)', System.IO.SearchOption.AllDirectories))" />
    </ItemGroup>

    <!-- IntermediateOutputPath (obj) -->
    <!-- Locate this project intermediate folder ({ArtifactsFolderName}\{IntermediateOutputFolderName}\{MSBuildProjectName}\). -->
    <ItemGroup Condition="Exists('$(BaseIntermediateOutputFolderPath)')">
      <_ProjectIntermediateOutputFolders Include="$(BaseIntermediateOutputFolderPath)" />
    </ItemGroup>

    <!-- OutputPath (bin) -->
    <!-- Execute cleanup on discovered output folders. -->
    <RemoveDir Directories="@(_ProjectOutputFolders)"
               Condition="'@(_ProjectOutputFolders)' != ''"
               ContinueOnError="true" />

    <!-- IntermediateOutputPath (obj) -->
    <!-- Execute cleanup on this project intermediate output folder. -->
    <RemoveDir Directories="@(_ProjectIntermediateOutputFolders)"
               Condition="'@(_ProjectIntermediateOutputFolders)' != ''"
               ContinueOnError="true" />

    <!-- Emit a single atomic log block per project so parallel worker nodes do not interleave lines. -->
    <PropertyGroup>
      <_CompletionMessage />
      <_CompletionMessage Condition="'@(_ProjectOutputFolders)' != '' OR '@(_ProjectIntermediateOutputFolders)' != ''">$(MSBuildProjectName): Project artifacts cleaned up:</_CompletionMessage>
      <_CompletionMessage Condition="'@(_ProjectOutputFolders)' != ''">$(_CompletionMessage)%0D%0A  Output folders:%0D%0A    @(_ProjectOutputFolders, '%0D%0A    ')</_CompletionMessage>
      <_CompletionMessage Condition="'@(_ProjectIntermediateOutputFolders)' != ''">$(_CompletionMessage)%0D%0A  Intermediate output folder:%0D%0A    @(_ProjectIntermediateOutputFolders, '%0D%0A    ')</_CompletionMessage>
      <_CompletionMessage Condition="'$(_CompletionMessage)' != ''">$(_CompletionMessage)%0D%0A</_CompletionMessage>
      <_CompletionMessage>$(_CompletionMessage)$(MSBuildProjectName): Completed project artifacts cleanup.</_CompletionMessage>
    </PropertyGroup>

    <Message Text="$(_CompletionMessage)"
             Importance="high" />
  </Target>

</Project>
