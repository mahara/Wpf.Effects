<Project>

  <!--
    PROPERTIES
  -->

  <!--
    SOLUTION BUILD (DEFAULT) PROPERTIES


    ============
    PATH MODEL
    ============

    - RuntimeIdentifier (RID) Path Re-evaluation

      - Evaluation Order and Timing
        Properties in Solution.Build.props (loaded through Directory.Build.props)
        are evaluated BEFORE individual .csproj files are parsed.
        If RuntimeIdentifier (RID) is defined locally inside a .csproj
        (rather than passed globally via CLI '-r' or MSBuild Global Properties),
        Solution.Build.props evaluates RID as empty during early import.

      - Late RID Path Resolution
        By re-evaluating RID-dependent paths inside Solution.Build.targets (post-.csproj parsing),
        RuntimeIdentifier is fully resolved from all sources (CLI arguments, Global Properties, or local .csproj).

      - Override Mechanics
        When $(RuntimeIdentifier) is non-empty, path properties append $(RuntimeIdentifier)\ directly
        after $(TargetFramework)\ to isolate intermediate objects, final binaries, and publish outputs.
        If $(RuntimeIdentifier) remains empty, the non-RID paths initialized in Solution.Build.props remain active.

  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <IntermediateOutputFolderPath>$(BaseIntermediateOutputFolderPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</IntermediateOutputFolderPath>
    <IntermediateOutputPath>$(IntermediateOutputFolderPath)</IntermediateOutputPath>

    <OutputBaseFolderPath>$(BaseOutputBaseFolderPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</OutputBaseFolderPath>
    <OutputFolderPath>$(OutputBaseFolderPath)$(MSBuildProjectName)\</OutputFolderPath>
    <OutputPath>$(OutputFolderPath)</OutputPath>
    <OutDir>$(OutputFolderPath)</OutDir>

    <RunWorkingDirectory>$(OutputFolderPath)</RunWorkingDirectory>

    <PublishFolderPath>$(PublishBaseFolderPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\$(MSBuildProjectName)\</PublishFolderPath>
    <PublishDir>$(PublishFolderPath)</PublishDir>
  </PropertyGroup>



  <!--
    TARGETS


    TARGET NAMING CONVENTION
    Format: [EventScope]_[ExecutionScope]_[TargetName]_[TriggerEvent]

    1. EventScope     : Lifecycle scope where the hook attaches (Project | Solution | Workspace).
    2. ExecutionScope : Operational blast radius of the target (Project | Solution | Workspace).
    3. TargetName     : Nominalized [Object][ActionNoun] phrase (e.g., TargetFrameworksValidation).
    4. TriggerEvent   : [Before|After][EventScope][MSBuildHook] (e.g., BeforeProjectPrepareForBuild).

  -->

  <!--
    SOLUTION BUILD TARGETS
  -->

  <!--
    Enforces solution-level targeting invariants defined in Solution.Build.props.
    Ensures every participating project explicitly uses multi-targeting ('TargetFrameworks')
    so outer/inner build dispatching and artifact path resolution behave deterministically.
  -->
  <Target Name="Project_Project_TargetFrameworksValidation_BeforeProjectPrepareForBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Error Text="'$(MSBuildProjectName)' must define 'TargetFrameworks'. Use 'TargetFrameworks', not 'TargetFramework'."
           Condition="'$(TargetFrameworks)' == ''" />
    <Error Text="'$(MSBuildProjectName)' active 'TargetFramework' is empty. This build layout requires a .NET SDK inner target-framework build."
           Condition="'$(TargetFramework)' == ''" />
  </Target>

</Project>
